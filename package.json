{
  "name": "gatekeeper-api",
  "version": "1.0.0",
  "description": "Event ticketing & Booking API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . --config eslint.local.config.js",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint . --config eslint.local.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node src/db/seed.js",
    "db:setup": "node src/db/setup.js"
  },
  "keywords": [],
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2"
  }
}
